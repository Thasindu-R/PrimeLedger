# Copy to .env.local and adjust. Never commit a filled-in copy.

# Base URL of the PrimeLedger API. Defaults to the local Spring Boot service.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# development | preview | production
VITE_APP_ENV=development

# Phase 3 — Supabase Auth. The anon key is safe to expose; row-level security
# is what protects the data. The service-role key must never appear here.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-public-key>
