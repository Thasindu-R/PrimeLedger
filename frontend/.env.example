# Copy to .env.local and adjust. Never commit a filled-in copy.

# Base URL of the PrimeLedger API. Defaults to the local Spring Boot service.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# development | preview | production
VITE_APP_ENV=development

# Supabase Auth. Required for sign-up and sign-in; without them the app loads
# and the auth pages explain what is missing rather than failing.
#
# The anon key is designed to be public — it identifies the project and grants
# nothing on its own, because row-level security is what protects the data. The
# service-role key bypasses every policy and must never appear in this file or
# anywhere else the browser can reach.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
