# PrimeLedger backend environment (proposal §A.2)
# Copy to backend/.env and fill in. Never commit the filled-in copy.

SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL.
#
# Two roles, and the split is load-bearing. DATABASE_USER runs migrations and
# owns the schema. APP_DATABASE_USER serves requests and is the one row-level
# security applies to — PostgreSQL lets a superuser, and an owner without FORCE,
# ignore every policy silently. Point both at the same role and the isolation
# guarantee is gone while the application still works perfectly.
#
# Create the runtime role's credentials once, by hand, on Supabase:
#   ALTER ROLE primeledger_app LOGIN PASSWORD '<a real secret>';
# The role itself is created by V2__row_level_security.sql, without a password.
DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=<password>
APP_DATABASE_USER=primeledger_app
APP_DATABASE_PASSWORD=<runtime-role-password>

# Refuse to start if the runtime role can bypass row-level security. Leave it
# on: turning it off does not disable RLS, it disables noticing that RLS is off.
REQUIRE_RLS=true

# Local development escape hatch. true skips authentication entirely and
# attributes every request to primeledger.dev.user-id. The application refuses
# to start with this set under the prod profile.
FIXED_USER=false

# Supabase Auth (GoTrue). The API verifies RS256 JWTs against the JWKS endpoint.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/jwks
SUPABASE_ISSUER=https://<project-ref>.supabase.co/auth/v1

# BACKEND ONLY. The service-role key bypasses every row-level security policy.
# If it reaches frontend code or a client bundle, RLS is void for all users
# (proposal §9.4). It must never appear outside this process's environment.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

CORS_ALLOWED_ORIGINS=http://localhost:5173,https://primeledger.vercel.app
FX_API_URL=https://api.frankfurter.app
RATE_LIMIT_PER_MINUTE=100
